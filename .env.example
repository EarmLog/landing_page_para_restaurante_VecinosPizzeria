# ---------------------------------------------------------------------------
# Configuración de Supabase (esquema aislado para Vecino's Pizzería)
# ---------------------------------------------------------------------------
# URL del proyecto Supabase compartido con otras aplicaciones
NEXT_PUBLIC_SUPABASE_URL=https://qqqpmabsdvqrjygvgfqy.supabase.co

# Llave pública (anon). Es segura para el cliente, solo permite lo que RLS autorice
