# Esquema exclusivo de esta aplicación dentro del proyecto compartido
NEXT_PUBLIC_SUPABASE_SCHEMA=vecinos_pizzeria

# ---------------------------------------------------------------------------
# Configuración de la aplicación
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Vecino's Pizzería

# Número de WhatsApp para recibir pedidos (formato internacional sin signos)
